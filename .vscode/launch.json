{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Website Directly (index.html)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Open Admin Portal Directly (admin.html)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/admin.html"
    },
    {
      "name": "Launch against Live Server (localhost:5500)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}"
    }
  ]
}